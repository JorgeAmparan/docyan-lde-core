# =============================================================================
# DOCYAN LDE™ by XCID — variables de entorno (fuente de verdad)
# -----------------------------------------------------------------------------
# Separadas por proceso de Fly (topología de 5 apps, CLAUDE.md §3):
#   - docyan-lde-api      → BACKEND (este bloque "BACKEND")
#   - docyan-lde-ingest   → WORKER de ingesta (bloque "WORKER")
#   - docyan-lde-graph    → FalkorDB (sin .env; volumen)
#   - docyan-lde-embedder → BGE-M3 (ver embedder/)
#   - docyan-lde-redis    → Redis (ver redis/)
#
# En PRODUCCIÓN, los valores marcados [SECRET] se fijan con `flyctl secrets set`
# (ver docs/runbook_secrets_produccion.md). Los marcados [ENV] van en `[env]`
# del fly.toml correspondiente (no sensibles). Este archivo es solo plantilla
# local — NUNCA commitear un .env real (gitleaks corre en CI).
# =============================================================================


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ BACKEND — docyan-lde-api                                                   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# JWT_SECRET [SECRET] — OBLIGATORIO, sin default (mín. 32 chars). Falla loud si falta.
JWT_SECRET=your-strong-random-secret-here-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Super-Admin de Plataforma (F2) ───────────────────────────────────────────
# Identidad del fundador (rol `platform_admin`, FUERA del RLS de tenant). El seed
# (scripts: python -m app.platform_admin.seed) usa estas variables; NO se hardcodean.
PLATFORM_ADMIN_EMAIL=fundador@xcid.com
PLATFORM_ADMIN_PASSWORD=set-a-strong-password-here
PLATFORM_ADMIN_NAME=Fundador XCID
PLATFORM_TOKEN_EXPIRE_MINUTES=60

# ── Onboarding + ciclo de uso (B13) ──────────────────────────────────────────
# Modelo Freemium / Piloto + invitaciones por correo. Todos opcionales (defaults
# razonables). FREEMIUM_SALDO_USD = saldo de cortesía para que la cuenta freemium
# pueda ingerir sus pocos docs (extracción ~$0.04/doc). PENDIENTE DE JORGE: monto.
FREEMIUM_DOC_LIMIT=3
# Tope de páginas por documento en freemium (rechazo con CTA de conversión).
FREEMIUM_MAX_PAGINAS=100
FREEMIUM_VENTANA_DIAS=30
FREEMIUM_SALDO_USD=2.0
PILOTO_VENTANA_DIAS=60
INVITATION_EXPIRE_HOURS=168
# Base pública de la app (para el enlace de invitación que llega por correo).
APP_BASE_URL=https://docyan-lde.vercel.app

# ── Correo saliente (B13: invitaciones) ──────────────────────────────────────
# [SECRET en prod] Si SMTP_HOST + EMAIL_FROM están definidos, las invitaciones se
# envían por SMTP (TLS). Si faltan, el flujo NO se bloquea: el correo se loguea y
# el enlace de invitación queda en la respuesta de la API para reenvío manual.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@docyan.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# [SECRET en prod] comma-separated, NO wildcard.
ALLOWED_ORIGINS=https://app.docyan.com,http://localhost:3000

# ── Supabase (PostgreSQL + Storage + Auth) ───────────────────────────────────
# CRÍTICO. B0.7: el backend usa SOLO service_role. La anon key (SUPABASE_KEY)
# quedó ELIMINADA del stack del backend (el aislamiento multi-tenant es a nivel
# de query — Doc 09 — y la integridad del FAT la da el hash chain — Doc 08 — no
# las RLS; el frontend nunca habla directo con Supabase). Solo 2 secrets:
#   - SUPABASE_URL          [SECRET] = Project URL
#   - SUPABASE_SERVICE_KEY  [SECRET] = service_role key (edb, grg, matrix, auth +
#                                      módulos fuera de alcance al reactivarse).
# Fuente: Supabase Dashboard → Project Settings → API.
# Sin estos 2 secrets, todo módulo del camino crítico falla con RuntimeError loud.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── LLMs de INGESTA (GraphRAG-SDK vía LiteLLM — B1) ──────────────────────────
# Extracción + Resolution: Gemini 2.5 Flash. El prefijo `gemini/` es OBLIGATORIO
# en el model string (gemini/gemini-2.5-flash); sin él LiteLLM defaultea a
# Vertex AI y falla pidiendo credenciales GCP. Variable GEMINI_API_KEY (NO GOOGLE_API_KEY).
GEMINI_API_KEY=your_gemini_api_key_here          # [SECRET]
# QA / consulta del pipeline de ingesta: gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here          # [SECRET]

# ── Precios de modelo + cobro de setup (cotizador/débito — F1.5) ─────────────
# Precios por 1M de tokens (USD). Sin estas vars se usan los valores vigentes del
# PoC. El founder los confirma al desplegar (PENDIENTE DE JORGE del contrato F1.5).
# PRICE_GEMINI_FLASH_IN_USD_PER_1M=0.30
# PRICE_GEMINI_FLASH_OUT_USD_PER_1M=2.50
# PRICE_GPT4O_MINI_IN_USD_PER_1M=0.15
# PRICE_GPT4O_MINI_OUT_USD_PER_1M=0.60
# PRICE_BGE_M3_USD_PER_1M=0.01                    # cómputo propio del embedder
# Fórmula de setup: MAX(SETUP_PRICE_FLOOR_USD, costo_base × SETUP_COST_MULTIPLIER) × FACTOR_COMPLEJIDAD
# SETUP_PRICE_FLOOR_USD=25.0
# SETUP_COST_MULTIPLIER=25.0
# FACTOR_COMPLEJIDAD=1.0                          # perilla futura por tipo documental

# ── LLMs de TRADUCCIÓN (Pista A, vía Model Router) ───────────────────────────
# Claude Sonnet 4.6 (+ Gemini 2.5 Pro). Tier medio piloto.
ANTHROPIC_API_KEY=your_anthropic_api_key_here    # [SECRET]
# Override opcional del Model Router (solo dev/debug).
# MR_OVERRIDE_MODEL=

# ── Estabilidad del event loop (Sprint ED-0) ─────────────────────────────────
# Corte duro de los paths autenticados: cada endpoint que llama código síncrono
# de pipeline se ejecuta en un thread con `asyncio.wait_for` (patrón demo.py).
# Al expirar → HTTP 504 y el event loop queda libre para responder /health.
# Default 30s (las consultas autenticadas pueden ser complejas; el demo usa 9s).
QUERY_TIMEOUT_SECONDS=30
# Timeout de red de las llamadas LLM (Gemini/LiteLLM), en segundos.
LLM_TIMEOUT_SECONDS=60

# ── BGE-M3 Embeddings (self-hosted, docyan-lde-embedder) ─────────────────────
# EMBEDDER_URL es la variable canónica (BGE_M3_URL es compat). Ambas [ENV].
# En prod van en fly.toml [env]; en local apuntan a localhost.
EMBEDDER_URL=http://localhost:8080
BGE_M3_URL=http://localhost:8080
BGE_M3_TIMEOUT=30
# Timeout de CONEXIÓN separado (ED-0 §3.2): connect corto distingue "embedder
# arrancando (cold-start ~5min)" de "colgado"; el read usa BGE_M3_TIMEOUT.
BGE_M3_CONNECT_TIMEOUT=10

# ── FalkorDB (DKG + DTM, docyan-lde-graph) ───────────────────────────────────
# FALKOR_HOST/FALKOR_PORT son canónicas (FALKORDB_* son compat). [ENV] en prod.
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=docyan
FALKOR_QUERY_TIMEOUT_MS=10000
# Socket timeouts del cliente FalkorDB (ED-0 §3.2). El query timeout es
# server-side; estos cortan a nivel socket un recv/connect estancado. socket ≥
# query timeout (10s) para no cortar queries legítimas; connect corto.
FALKORDB_SOCKET_TIMEOUT=15
FALKORDB_SOCKET_CONNECT_TIMEOUT=5

# ── Redis (sesiones MO/APScheduler B4 + cola de ingesta B2) ──────────────────
# REDIS_URL [SECRET en prod] — sesiones / scheduler.
# REDIS_QUEUE_URL [SECRET en prod] — cola de ingesta (la usa el cotizador del
#   backend para encolar y el worker para consumir). En prod ambas apuntan a
#   docyan-lde-redis.internal:6379.
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6379/0
# Socket timeouts del cliente Redis (ED-0 §3.2). Cortos: Redis vive en la red
# privada de Fly (respuesta inmediata o falla).
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=3

# ── Org / data ───────────────────────────────────────────────────────────────
ORG_ID=your_org_id
DATA_DIR=./data

# ── Dev API key (opcional, solo desarrollo) ──────────────────────────────────
# Solo setear si necesitas auth por X-API-Key en desarrollo.
# API_KEY=your-dev-api-key

# ── Flags de módulos FUERA DE ALCANCE MVP (B0.7) ─────────────────────────────
# Los módulos legacy/diferidos (Adenda 31-may-2026) están guardados con
# require_module_enabled y fallan loud en producción salvo que se habiliten
# EXPLÍCITAMENTE con su flag = "1". En MVP se dejan SIN setear (deshabilitados).
# Ver docs/DOCYAN_Adenda_Alcance_MVP_ConsultaViva.md.
# DOCYAN_ENABLE_DII=0           # pipeline legacy (reemplazado por GraphRAG-SDK)
# DOCYAN_ENABLE_BILLING=0       # Stripe (difiere a 3-5 clientes, decisión #13)
# DOCYAN_ENABLE_GOVERNANCE=0    # rutas UI #3 PM (diferida)
# DOCYAN_ENABLE_DOCUMENTS=0     # router DII-tied (ingesta MVP va por el worker)
# DOCYAN_ENABLE_MCP_SERVER=0    # servidor MCP (no MVP)

# ── Stripe (billing — opcional, requiere DOCYAN_ENABLE_BILLING=1) ────────────
STRIPE_SECRET_KEY=sk_test_...                    # [SECRET]
STRIPE_WEBHOOK_SECRET=whsec_...                  # [SECRET]
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── WhatsApp 360dialog (B9 — aún no cableado en código) ──────────────────────
# WA_360DIALOG_API_KEY=                           # [SECRET]
# WA_360DIALOG_WEBHOOK_SECRET=                    # [SECRET]

# ── Conectores / ingest_sources (NO foco MVP — opcionales) ───────────────────
# SQL connector
SQL_DB_TYPE=mysql
SQL_HOST=localhost
SQL_PORT=3306
SQL_DATABASE=nombre_bd
SQL_USER=usuario
SQL_PASSWORD=password
# SQL_CONNECTION_STRING=dialect+driver://user:pass@host/db
# Microsoft Graph (OneDrive/SharePoint)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=                            # [SECRET]
# AZURE_TENANT_ID=
# ONEDRIVE_USER_ID=
# FTP / SFTP
# FTP_HOST=
# FTP_PORT=21
# FTP_USER=
# FTP_PASSWORD=                                   # [SECRET]
# FTP_PROTOCOL=ftp
# Notion
# NOTION_TOKEN=                                   # [SECRET]
# Google Drive (service account o OAuth)
# GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_CREDENTIALS_FILE=
# LangExtract (puenteado desde GEMINI_API_KEY si no se setea; ver dii.py)
# LANGEXTRACT_API_KEY=


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ WORKER — docyan-lde-ingest                                                 ║
# ║ (Construido en B2; vive en worker/. Docling + GraphRAG-SDK + FalkorDB +    ║
# ║  LLM. F1.5: además LIQUIDA/LIBERA el saldo al completar/fallar, por lo que ║
# ║  requiere SUPABASE_URL + SUPABASE_SERVICE_KEY para tocar tenant_budget.)   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Secrets del worker (flyctl secrets set --app docyan-lde-ingest):
#   GEMINI_API_KEY        [SECRET] — extracción/resolution (mismo valor que backend)
#   OPENAI_API_KEY        [SECRET] — QA gpt-4o-mini
#   REDIS_QUEUE_URL       [SECRET] — cola de la que consume jobs
#   SUPABASE_URL          [SECRET] — F1.5: liquidar/liberar saldo en tenant_budget
#   SUPABASE_SERVICE_KEY  [SECRET] — F1.5: service_role para tenant_budget
#
# [ENV] del worker (ya en worker/fly.toml, NO son secrets):
#   FALKOR_HOST=docyan-lde-graph.internal
#   FALKOR_PORT=6379
#   EMBEDDER_URL=http://docyan-lde-embedder.internal:8000
#   HF_HUB_OFFLINE=1
#   TRANSFORMERS_OFFLINE=1
#   DOCLING_ARTIFACTS_PATH=/root/.cache/docling/models
#
# Opcionales del worker:
#   WORKER_POP_TIMEOUT=5         # timeout del BLPOP de la cola (segundos)
#   INGEST_STORAGE_DIR=          # dir de artefactos de ingesta si aplica
